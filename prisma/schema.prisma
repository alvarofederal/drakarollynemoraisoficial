// prisma/schema.prisma
// Projeto: Dra. Karollyne Morais — landing page de venda do livro

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ─────────────────────────────────────────
// ADMIN — acesso ao painel de pedidos
// ─────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senha        String
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("users")
}

// ─────────────────────────────────────────
// PEDIDOS — quem se interessou / comprou o livro
// ─────────────────────────────────────────

model Pedido {
  id          String  @id @default(cuid())
  nome        String
  email       String?
  telefone    String

  // Endereço de entrega (estruturado — facilita etiqueta de envio)
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String? @db.VarChar(2)

  quantidade  Int          @default(1)
  status      StatusPedido @default(AGUARDANDO)
  observacao  String?      @db.Text

  // Rastreio de origem (?utm_source=instagram, etc.)
  origem      String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status])
  @@index([criadoEm])
  @@index([email])
  @@map("pedidos")
}

enum StatusPedido {
  AGUARDANDO // preencheu os dados, ainda não confirmou o pagamento
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
}
